#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        betterholdandtap: betterholdandtap {
            compatible = "zmk,behavior-hold-tap";
            label = "BETTERHOLDANDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <(-1)>;
            require-prior-idle-ms = <100>;
        };

        tap_dance: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&to 1>, <&to 0>;

            tapping-term-ms = <200>;
        };

        holdLayerTapletter: holdLayerTapletter {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDLAYERTAPLETTER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    macros {
        git_push: git_push {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp S &kp H>;
            label = "GIT_PUSH";
        };

        git_commit: git_commit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp C &kp O &kp M &kp M &kp I &kp T &kp SPACE &kp MINUS &kp M &kp SPACE &kp DQT &kp DQT>;
            label = "GIT_COMMIT";
        };

        git_pull_rebase: git_pull_rebase {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp L &kp L &kp SPACE &kp MINUS &kp MINUS &kp R &kp E &kp B &kp A &kp S &kp E &kp SPACE &kp O &kp R &kp I &kp G &kp I &kp N &kp SPACE &kp D &kp E &kp V>;
            label = "GIT_PULL_REBASE";
        };

        git_fetch: git_fetch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp F &kp E &kp T &kp C &kp H>;
            label = "GIT_FETCH";
        };

        git_rebase_continue: git_rebase_continue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp R &kp E &kp B &kp A &kp S &kp E &kp SPACE &kp MINUS &kp MINUS &kp C &kp O &kp N &kp T &kp I &kp N &kp U &kp E>;
            label = "GIT_REBASE_CONTINUE";
        };

        git_add_all: git_add_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp A &kp D &kp D &kp SPACE &kp DOT>;
            label = "GIT_ADD_ALL";
        };

        git_add: git_add {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp A &kp D &kp D>;
            label = "GIT_ADD";
        };

        claude: claude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp L &kp A &kp U &kp D &kp E &kp RET>;
            label = "CLAUDE";
        };

        nvim: nvim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N &kp V &kp I &kp M &kp N &kp V &kp I &kp M &kp RET>;
            label = "NVIM";
        };

        git_push_force_with_lease: git_push_force_with_lease {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp G &kp I &kp T &kp SPACE &kp P &kp U &kp S &kp H &kp SPACE &kp MINUS &kp MINUS &kp F &kp O &kp R &kp C &kp E &kp MINUS &kp W &kp I &kp T &kp H &kp MINUS &kp L &kp E &kp A &kp S &kp E>;
            label = "GIT_PUSH_FORCE_WITH_LEASE";
        };

        glab_mr_create: glab_mr_create {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp L &kp A &kp B &kp SPACE &kp M &kp R &kp SPACE &kp C &kp R &kp E &kp A &kp T &kp E>;
            label = "GLAB_MR_CREATE";
        };

        cm_name: cm_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp M &kp SPACE &kp MINUS &kp MINUS &kp N &kp A &kp M &kp E &kp SPACE>;
            label = "CM_NAME";
        };

        venv_activate: venv_activate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp O &kp U &kp R &kp C &kp E &kp SPACE &kp DOT &kp FSLH &kp V &kp E &kp N &kp V &kp FSLH &kp B &kp I &kp N &kp FSLH &kp A &kp C &kp T &kp I &kp V &kp A &kp T &kp E &kp RET>;
            label = "VENV_ACTIVATE";
        };

        venv_deactivate: venv_deactivate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp E &kp A &kp C &kp T &kp I &kp V &kp A &kp T &kp E>;
            label = "VENV_DEACTIVATE";
        };

        pytest: pytest {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp Y &kp T &kp E &kp S &kp T &kp SPACE>;
            label = "PYTEST";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W                     &kp E                          &kp R                    &kp T        &kp Y          &kp U  &kp I                          &kp O                      &kp P     &mo 5
&kp ESC    &kp A  &betterholdandtap LALT S  &betterholdandtap RIGHT_ALT D  &holdLayerTapletter 2 F  &kp G        &kp H          &kp J  &betterholdandtap RIGHT_ALT K  &betterholdandtap LCTRL L  &kp SEMI  &kp APOSTROPHE
&kp LSHFT  &kp Z  &kp X                     &kp C                          &kp V                    &kp B        &kp N          &kp M  &kp COMMA                      &kp DOT                    &kp FSLH  &mo 3
                                            &kp LCTRL                      &mo 1                    &kp SPACE    &kp BACKSPACE  &mo 2  &kp ENTER
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB    &kp LA(S)         &trans            &trans            &trans            &trans              &kp LEFT_ARROW    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp NUMBER_0  &trans
&kp ESC    &kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4      &kp NUMBER_5        &kp NUMBER_6      &kp NUMBER_7    &kp NUMBER_8  &kp NUMBER_9     &trans        &trans
&kp LSHFT  &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)    &kp LA(NUMBER_6)  &trans          &trans        &trans           &trans        &trans
                                               &kp LCTRL         &trans            &kp SPACE           &kp BACKSPACE     &mo 2           &kp ENTER
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB     &trans           &kp KP_SUBTRACT  &kp GRAVE  &kp CARET   &kp EQUAL      &kp PLUS        &kp AMPS        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_MULTIPLY    &trans
&kp ESCAPE  &kp EXCLAMATION  &kp AT_SIGN      &kp HASH   &kp DOLLAR  &kp PERCENT    &kp UNDERSCORE  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp LEFT_BRACKET       &kp RIGHT_BRACKET  &trans
&kp LSHFT   &trans           &trans           &trans     &trans      &trans         &trans          &trans          &trans                &kp BACKSLASH          &kp PIPE           &trans
                                              &kp LCTRL  &trans      &kp SPACE      &kp BACKSPACE   &trans          &kp ENTER
            >;
        };

        layer_3 {
            display-name = "bluetooth";
            bindings = <
&ext_power EP_TOG  &ext_power EP_ON  &ext_power EP_OFF  &trans        &trans        &trans          &ext_power EP_TOG  &ext_power EP_ON  &ext_power EP_OFF  &trans                             &trans                          &trans
&bt BT_CLR         &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &rgb_ug RGB_ON     &rgb_ug RGB_EFF   &rgb_ug RGB_EFR    &rgb_ug RGB_COLOR_HSB(253,100,48)  &rgb_ug RGB_COLOR_HSB(0,91,50)  &rgb_ug RGB_COLOR_HSB(183,71,53)
&bt BT_CLR_ALL     &rgb_ug RGB_TOG   &trans             &trans        &trans        &kp A           &bl BL_TOG         &trans            &trans             &trans                             &trans                          &trans
                                                        &trans        &trans        &trans          &trans             &trans            &trans
            >;
        };

        layer_4 {
            display-name = "colemak";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp F      &kp P  &kp B        &kp J     &kp L  &kp U      &kp Y    &kp SEMI  &to 0
&kp ESCAPE      &kp A  &kp R  &kp S      &kp T  &kp G        &kp M     &kp N  &kp E      &kp I    &kp O     &kp APOS
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp D  &kp V        &kp K     &kp H  &kp COMMA  &kp DOT  &kp FSLH  &ext_power EP_TOG
                              &kp LCTRL  &mo 1  &kp SPACE    &kp BSPC  &mo 2  &kp ENTER
            >;
        };

        layer_5 {
            bindings = <
&git_add                    &git_add_all    &git_commit       &git_push  &glab_mr_create  &git_pull_rebase    &trans  &trans  &trans  &trans  &trans   &trans
&git_push_force_with_lease  &kp F1          &kp F2            &kp F3     &kp F4           &kp F5              &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans                      &venv_activate  &venv_deactivate  &cm_name   &claude          &trans              &trans  &trans  &trans  &trans  &trans   &trans
                                                              &trans     &pytest          &nvim               &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
